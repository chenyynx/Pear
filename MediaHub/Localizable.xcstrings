    "Used under the MDBList terms of service": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据 MDBList 服务条款使用"
          }
        }
      }
    },
    "Used under the Simkl API terms of use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据 Simkl API 使用条款使用"
          }
        }
      }
    },
    "Used under the TMDB API terms of use": {
      "localizations": {
