            "value": "添加用户"
          }
        }
      }
    },
    "Add a TMDB key under Integrations to unlock genre insights and exact episode counts and runtimes. Until then, runtimes are estimated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「集成」中添加 TMDB 密钥，即可解锁类型洞察以及精确的集数和时长。在此之前，时长均为估算。"
          }
        }
      }
    },
    "Add a free TMDB API key in Settings → Integrations to browse trending titles and filter by genre and year.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置 → 集成」中添加免费的 TMDB API 密钥，即可浏览热门影片并按类型和年份筛选。"
          }
        }
      }
    },
    "Add a stream add-on or connect a media server in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中添加流媒体插件，或连接媒体服务器。"
          }
        }
      }
    },
    "Add add-on": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加插件"
          }
        }
