    "Open your AIOMetadata page, choose the catalogues you want it to offer, then paste the add-on link it gives you (https:// or stremio://). You then pick which of them appear on Home.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你的 AIOMetadata 页面，选择你想让它提供的目录，然后粘贴它给出的插件链接（https:// 或 stremio://）。之后你可以挑选哪些目录显示在首页。"
          }
        }
      }
    },
    "Open-source components": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源组件"
          }
        }
      }
    },
    "Optional while your Simkl name is in use. It is kept as a fallback.": {
