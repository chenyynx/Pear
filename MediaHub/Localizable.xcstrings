    "Trending Movies": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热门电影"
          }
        }
      }
    },
    "Trending Shows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热门剧集"
          }
        }
      }
    },
    "Trending, Explore, recommendations, episode thumbnails, title logos and skip-intro matching. Without it, most of the app stays empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热门、发现、推荐、剧集缩略图、片名台标和跳过片头匹配。没有它，App 的大部分内容都会是空的。"
          }
        }
      }
    },
    "Try a different genre or year.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他类型或年份。"
